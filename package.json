{
  "name": "cpplab-online-ide",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Client-only C++ IDE: clang compiled to WebAssembly, running in a worker",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "i18n:check": "tsx scripts/i18n-check.mts",
    "i18n:ui": "node scripts/i18n-ui-check.cjs"
  },
  "dependencies": {
    "@gameguild/emception-browser": "4.5.2",
    "emception": "4.5.2",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
